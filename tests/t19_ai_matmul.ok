# TEST 19 — ai.matmul: AVX2 cache-tiled FP32 matrix×vector
# A = [[1,2],[3,4]], x = [1,1]  → y = [3, 7]
# y[0] = 1*1+2*1 = 3 → bits = 0x40400000 = 1077936128
# y[1] = 3*1+4*1 = 7 → bits = 0x40E00000 = 1088421888

use ai

set A = ai.alloc(4)
set x = ai.alloc(2)
set y = ai.alloc(2)

# Row 0: [1.0, 2.0]
ai.set(A, 0, 1065353216)
ai.set(A, 1, 1073741824)
# Row 1: [3.0, 4.0]
ai.set(A, 2, 1077936128)
ai.set(A, 3, 1082130432)

# x = [1.0, 1.0]
ai.set(x, 0, 1065353216)
ai.set(x, 1, 1065353216)

ai.matmul(A, x, y, 2, 2)

set y0 = ai.get(y, 0)
set y1 = ai.get(y, 1)

# y0 = 3.0 = 1077936128
# y1 = 7.0 = 1088421888
print(y0)
print(y1)

ai.free(A)
ai.free(x)
ai.free(y)
