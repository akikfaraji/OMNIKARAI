# REGRESSION r03 — signed division and modulo (C truncation semantics)
# Historical bug: SAR/AND/Barrett fast paths were wrong for negative
# operands; replaced by CQO + IDIV (finding #14 / FIX N1).
# Expected: 3 -3 -3 3 1 -1 1 -1 3 -3 -3 3 0 0 0 0 0 0 0 -1
print(7 / 2)
print(-7 / 2)
print(7 / -2)
print(-7 / -2)
print(7 % 2)
print(-7 % 2)
print(7 % -2)
print(-7 % -2)
print(9 / 3)
print(-9 / 3)
print(9 / -3)
print(-9 / -3)
print(9 % 3)
print(-9 % 3)
print(9 % -3)
print(-9 % -3)
print(0 / 5)
print(0 % 5)
print(1 / 3)
print(-1 % 3)
